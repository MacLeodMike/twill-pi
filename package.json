{
  "name": "twill-pi",
  "version": "0.2.0",
  "description": "Substrate for twill fabric pi adapters — config, registry client, consumer identity, per-kind session state; registers the /twill status command. The workspace tools live in twill-pi-workspace.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "exports": {
    "./config": "./src/config.ts",
    "./registry-client": "./src/registry-client.ts",
    "./resolve-types": "./src/resolve-types.ts",
    "./session-state": "./src/session-state.ts"
  },
  "files": [
    "index.ts",
    "src",
    "README.md"
  ],
  "keywords": [
    "pi-package"
  ],
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "scripts": {
    "test": "vitest run"
  },
  "peerDependencies": {
    "typebox": "*"
  },
  "devDependencies": {
    "@types/node": "^22.7.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
