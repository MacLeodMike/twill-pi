{
  "name": "@bitwise-operations/twill-pi",
  "version": "0.1.0",
  "description": "pi substrate for the twill fabric: config, registry client, consumer identity, per-kind session state, the embedded provider, and the /twill status command.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": "./index.ts",
    "./config": "./src/config.ts",
    "./registry-client": "./src/registry-client.ts",
    "./resolve-types": "./src/resolve-types.ts",
    "./session-state": "./src/session-state.ts"
  },
  "files": [
    "index.ts",
    "src",
    "README.md"
  ],
  "keywords": [
    "pi-package",
    "twill",
    "pi-extension",
    "agent",
    "workspace"
  ],
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "scripts": {
    "test": "vitest run"
  },
  "dependencies": {
    "@bitwise-operations/twill": "file:/home/example/repos/twill"
  },
  "peerDependencies": {
    "typebox": "*"
  },
  "devDependencies": {
    "@types/node": "^22.7.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MacLeodMike/twill-pi.git"
  }
}
